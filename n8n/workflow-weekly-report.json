{
  "name": "ArcanaInsight — Weekly Operations Report",
  "nodes": [
    {
      "parameters": {
        "rule": { "interval": [{ "field": "cronExpression", "expression": "0 9 * * 5" }] }
      },
      "id": "cron-weekly",
      "name": "매주 금요일 18:00 KST",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [250, 300]
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "SELECT service_type, topic, spread_type, character_id, COUNT(*) as count, COUNT(CASE WHEN status = 'completed' THEN 1 END) as completed FROM sessions WHERE created_at >= NOW() - INTERVAL '7 days' GROUP BY service_type, topic, spread_type, character_id ORDER BY count DESC"
      },
      "id": "query-sessions",
      "name": "Supabase: 주간 세션 통계",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.5,
      "position": [470, 250],
      "credentials": {
        "postgres": { "id": "supabase-db", "name": "Supabase DB" }
      }
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "SELECT COUNT(*) as total_readings, COUNT(DISTINCT session_id) as total_sessions, ROUND(AVG(CHAR_LENGTH(overall_reading))) as avg_length FROM readings WHERE created_at >= NOW() - INTERVAL '7 days'"
      },
      "id": "query-readings",
      "name": "Supabase: 주간 리딩 통계",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.5,
      "position": [470, 400],
      "credentials": {
        "postgres": { "id": "supabase-db", "name": "Supabase DB" }
      }
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://api.github.com/repos/xzawed/ArcanaInsight/issues",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ title: '📈 주간 운영 리포트 — ' + new Date().toISOString().split('T')[0], body: '## 주간 운영 통계\\n\\n### 리��� 현황\\n| 항목 | 값 |\\n|------|-----|\\n| 총 리딩 | ' + ($json.total_readings || 0) + '건 |\\n| 총 세션 | ' + ($json.total_sessions || 0) + '건 |\\n| 평균 해석 길이 | ' + ($json.avg_length || 0) + '자 |\\n\\n---\\n*n8n Weekly Report에 의해 자동 생성*', labels: ['report'] }) }}"
      },
      "id": "create-report",
      "name": "GitHub: 리포트 Issue 생성",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [910, 300],
      "credentials": {
        "httpHeaderAuth": { "id": "github-pat", "name": "GitHub PAT" }
      }
    }
  ],
  "connections": {
    "매주 금요일 18:00 KST": {
      "main": [
        [
          { "node": "Supabase: 주간 세션 통계", "type": "main", "index": 0 },
          { "node": "Supabase: 주간 리딩 통계", "type": "main", "index": 0 }
        ]
      ]
    },
    "Supabase: 주간 리딩 통계": { "main": [[{ "node": "GitHub: 리포트 Issue 생성", "type": "main", "index": 0 }]] }
  }
}
