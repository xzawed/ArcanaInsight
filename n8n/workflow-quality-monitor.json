{
  "name": "ArcanaInsight — Daily Quality Monitor",
  "nodes": [
    {
      "parameters": {
        "rule": { "interval": [{ "field": "cronExpression", "expression": "0 0 * * *" }] }
      },
      "id": "cron-daily",
      "name": "매일 09:00 KST",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [250, 300]
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "SELECT COUNT(*) as total, COUNT(CASE WHEN card_interpretation IS NOT NULL AND array_length(card_interpretation, 1) > 0 THEN 1 END) as with_cards, AVG(CHAR_LENGTH(overall_reading)) as avg_reading_length, MIN(CHAR_LENGTH(overall_reading)) as min_reading_length FROM readings WHERE created_at >= NOW() - INTERVAL '24 hours'"
      },
      "id": "query-stats",
      "name": "Supabase: 24시간 리딩 ��계",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.5,
      "position": [470, 300],
      "credentials": {
        "postgres": { "id": "supabase-db", "name": "Supabase DB" }
      }
    },
    {
      "parameters": {
        "conditions": {
          "combinator": "and",
          "conditions": [
            {
              "leftValue": "={{ $json.total }}",
              "rightValue": "0",
              "operator": { "type": "number", "operation": "gt" }
            }
          ]
        }
      },
      "id": "check-empty",
      "name": "리딩 존재 여부",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [690, 300]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://api.github.com/repos/xzawed/ArcanaInsight/issues",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ title: '📊 일일 리딩 통계 — ' + new Date().toISOString().split('T')[0], body: '## 최근 24시간 리딩 통계\\n\\n| 항목 | 값 |\\n|------|-----|\\n| 총 리딩 수 | ' + $json.total + ' |\\n| 카드 해석 포함 | ' + $json.with_cards + ' |\\n| 평균 해석 길이 | ' + Math.round($json.avg_reading_length || 0) + '자 |\\n| 최소 해석 길이 | ' + Math.round($json.min_reading_length || 0) + '자 |\\n\\n' + (($json.min_reading_length || 0) < 100 ? '⚠️ 최소 해석 길이가 100자 미만입니다. 품질 확인 필요.' : '✅ 정상 범위') + '\\n\\n---\\n*n8n Daily Monitor에 의해 자동 생성*', labels: ['qa', 'quality-report'] }) }}"
      },
      "id": "create-issue",
      "name": "GitHub: 통계 Issue 생성",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [910, 300],
      "credentials": {
        "httpHeaderAuth": { "id": "github-pat", "name": "GitHub PAT" }
      }
    }
  ],
  "connections": {
    "매일 09:00 KST": { "main": [[{ "node": "Supabase: 24시간 리딩 통계", "type": "main", "index": 0 }]] },
    "Supabase: 24시간 리딩 통계": { "main": [[{ "node": "리딩 존재 여부", "type": "main", "index": 0 }]] },
    "리딩 존재 여부": { "main": [[{ "node": "GitHub: 통계 Issue 생성", "type": "main", "index": 0 }]] }
  }
}
