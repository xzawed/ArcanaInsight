# LLM providers
GROK_API_KEY=xai-your_grok_api_key
GROK_MODEL=grok-3
ANTHROPIC_API_KEY=sk-ant-your_anthropic_key
CLAUDE_MODEL=claude-sonnet-4-20250514

# AI tuning
AI_TIMEOUT_MS=60000
AI_DEFAULT_MAX_TOKENS=4000
AI_TEMPERATURE=0.7
AI_FALLBACK_COOLDOWN_MS=300000
AI_AUTH_COOLDOWN_MS=1800000

# Database
