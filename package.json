{
  "name": "arcana-insight",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "type-check": "tsc --noEmit",
    "test": "vitest run --coverage",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:full": "tsx scripts/e2e-full/orchestrator.ts --mode=full --workers=6",
    "test:e2e:full:ci": "tsx scripts/e2e-full/orchestrator.ts --mode=ci",
    "download:skins": "tsx --env-file=.env.local scripts/download-skin-images.ts"
  },
  "dependencies": {
    "@supabase/ssr": "^0.9.0",
    "@supabase/supabase-js": "^2.100.1",
    "drizzle-orm": "^0.45.2",
    "framer-motion": "^12.38.0",
    "next": "16.2.3",
    "next-auth": "5.0.0-beta.30",
    "postgres": "^3.4.9",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "tyme4ts": "^1.4.5",
    "zod": "^4.3.6",
    "zustand": "^5.0.12",
    "@verum/sdk": "latest"
  },
  "devDependencies": {
    "@playwright/test": "^1.59.1",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitest/coverage-v8": "^2.0.0",
    "dotenv": "^17.4.0",
    "drizzle-kit": "^0.31.10",
    "eslint": "^9",
    "@anthropic-ai/sdk": "^0.92.0",
    "eslint-config-next": "16.2.3",
    "tailwindcss": "^4",
    "tsx": "^4.21.0",
    "typescript": "^5",
    "vitest": "^2.0.0"
  }
}
